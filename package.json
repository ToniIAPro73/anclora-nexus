{
  "name": "anclora-nexus-root",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "ops:notebooklm:build-sync-pack": "node scripts/build-notebooklm-sync-pack.mjs",
    "ops:notebooklm:validate-sync-pack": "node scripts/validate-notebooklm-sync-pack.mjs",
    "ops:notebooklm:ops-summary": "node scripts/notebooklm-sync-ops-summary.mjs",
    "ops:release-gate": "node scripts/release-gate-operational.mjs",
    "ops:statefox:capture": "node scripts/statefox-live-capture.mjs",
    "frontend:dev": "npm run dev -w frontend",
    "frontend:build": "npm run build -w frontend",
    "frontend:start": "npm run start -w frontend",
    "frontend:lint": "npm run lint -w frontend",
    "build": "npm run build -w frontend",
    "dev": "node -e \"const p='../anclora-infrastructure/scripts/free-port.mjs';if(require('fs').existsSync(p)){try{require('child_process').execFileSync(process.execPath,[p],{stdio:'inherit'})}catch(e){process.exit(e.status||1)}}\" && npm run dev -w frontend",
    "lint": "npm run frontend:lint",
    "ops:guesthub-pilot:check-env": "node scripts/check-env-guesthub-pilot.mjs"
  },
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "playwright": "^1.58.2"
  }

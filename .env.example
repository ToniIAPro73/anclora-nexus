# === ANCLORA NEXUS CONFIGURATION EXAMPLE ===

# --- SUPABASE: LOCAL DEVELOPMENT ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
PUBLIC_CTA_ORG_ID=00000000-0000-0000-0000-000000000000

# --- SUPABASE: CLOUD PRODUCTION ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-cloud-anon-key
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-cloud-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-cloud-service-role-key
# PUBLIC_CTA_ORG_ID=00000000-0000-0000-0000-000000000000

# --- AI RUNTIME PROFILE ---
AI_RUNTIME_PROFILE=groq-cloudflare

# Groq chat runtime
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_PRIMARY=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_NO_EVIDENCE=llama-3.1-8b-instant
GROQ_MODEL_GUARD=llama-3.1-8b-instant

# Cloudflare copy/edge runtime
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=
CLOUDFLARE_MODEL_PRIMARY=@cf/openai/gpt-oss-20b
CLOUDFLARE_MODEL_FALLBACK=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_MODEL_FAST=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_MODEL_NO_EVIDENCE=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_MODEL_GUARD=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-small-en-v1.5

# Internal audit integrity secret
INTERNAL_AUDIT_SECRET=replace-with-random-secret

# --- VERCEL CRON ---
# Random secret string — set the same value in Vercel Dashboard > Settings > Environment Variables
CRON_SECRET=your-random-cron-secret

# --- N8N WEBHOOKS ---
# Set these only in your local untracked `.env`
N8N_WEBHOOK_URL=
N8N_API_KEY=

# --- SCRAPING ENGINE ---
# Firecrawl: general web scraping + on-demand URL extraction
# Get your key at: https://firecrawl.dev
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Apify: scheduled portal scraping (Idealista, Fotocasa actors)
# Dashboard: https://console.apify.com
APIFY_API_TOKEN=your-apify-api-token
APIFY_API_BASE_URL=https://api.apify.com/v2

# --- NOTEBOOKLM TERRITORIAL BRAIN ---
# Use your active NotebookLM notebook (e.g. "Inteligencia Territorial Suroeste Mallorca 2026")
NOTEBOOKLM_NOTEBOOK_ID=9f003773-16c5-4fb4-ab37-7b6c230ab4da
NOTEBOOKLM_NOTEBOOK_NAME=Inteligencia Territorial Suroeste Mallorca 2026
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- GENERAL APP SETTINGS ---
APP_ENV=development
ALLOW_REAL_SUPABASE_WRITE=false
USE_SYNTHETIC_DATA_ONLY=true
RESEND_API_KEY=
# RESEND_FROM takes precedence. Keep both sender variables aligned while
# RESEND_FROM_EMAIL remains supported for compatibility.
RESEND_FROM=Anclora Nexus <no-reply@anclora.com>
RESEND_FROM_EMAIL=Anclora Nexus <no-reply@anclora.com>
RESEND_REPLY_TO=soporte@anclora.com
ADMIN_EMAILS=antonio@anclora.com
HERMES_WORKER_URL=http://localhost:8787
HERMES_WORKER_API_KEY=

# --- GUESTHUB CONTROLLED PILOT (formerly Anclora SyncXML, renamed 2026-08) ---
# Canonical names are GUESTHUB_*; the backend still accepts the legacy SYNCXML_*
# names as fallback during the transition. URLs stay on the legacy
# anclora-syncxml.vercel.app deployment until the owner decides the new domain.
GUESTHUB_ENV=development
GUESTHUB_APP_URL=https://anclora-syncxml.vercel.app
GUESTHUB_LOGIN_URL=https://anclora-syncxml.vercel.app/login
GUESTHUB_WEBHOOK_SECRET=
GUESTHUB_INTERNAL_API_URL=
GUESTHUB_INTERNAL_API_SECRET=
GUESTHUB_PILOT_AUTO_APPROVE=false

# --- ADVANCED DOCUMENT PARSING / MINERU ---
ENABLE_MINERU_PARSER=false
MINERU_AGENT_INGEST_PATH=/home/toni/projects/agent-tooling/mineru/bin/mineru-agent-ingest.sh
MINERU_DEFAULT_BACKEND=pipeline
MINERU_OUTPUT_BASE=/home/toni/projects/agent-tooling/mineru/output
MINERU_PARSE_TIMEOUT_MS=180000

# --- REAL ESTATE DMS / SIGNATURES / ADVISOR AI ---
NEXUS_DOCUMENT_ENCRYPTION_KEY=
NEXUS_DMS_BUCKET=dms
NEXUS_DMS_MAX_UPLOAD_BYTES=26214400
DOCUSEAL_WEBHOOK_SECRET=
DOCUSEAL_API_KEY=
DOCUSEAL_API_URL=https://api.docuseal.com
ADVISOR_AI_BASE_URL=http://localhost:3000
ADVISOR_AI_INTERNAL_API_KEY=
ADVISOR_AI_TIMEOUT_SECONDS=12
NEXT_PUBLIC_DMS_ENABLED=true

# --- DMS/CLM COMPLETE (migration 003) ---
# Storage buckets (Supabase Storage private buckets)
NEXUS_TEMPLATE_BUCKET=dms-templates
NEXUS_GENERATED_DOCUMENT_BUCKET=dms-generated
NEXUS_SIGNED_DOCUMENT_BUCKET=dms-signed
NEXUS_SIGNATURE_EVIDENCE_BUCKET=dms-signature-evidence
NEXUS_DOSSIER_EXPORT_BUCKET=dms-exports-temp

# Dossier export settings
NEXUS_EXPORT_TTL_MINUTES=60
NEXUS_EXPORT_MAX_SIZE_MB=500
NEXUS_EXPORT_ENCRYPTION_ENABLED=false

# Signing provider
DOCUSEAL_WEBHOOK_HMAC_ALGORITHM=sha256

# Document rendering engine: markdown | docx | pdf
DOCUMENT_RENDERING_ENGINE=markdown

# Template seed control
DOCUMENT_TEMPLATE_SEED_ENABLED=false

# Feature flags
NEXT_PUBLIC_DMS_TEMPLATE_LIBRARY_ENABLED=true
NEXT_PUBLIC_DMS_LEGAL_REVIEW_ENABLED=true
NEXT_PUBLIC_DMS_DOSSIER_EXPORT_ENABLED=false
